  "guion": [
    {"inicio": 0.1,  "fin": 1.9,  "texto": "¿Sabes el secreto del Coco?"},
    {"inicio": 2.0,  "fin": 4.8,  "texto": "¡Al Coco le dan miedo los niños!"},
    {"inicio": 5.2,  "fin": 9.6,  "texto": "Y hoy es su noche más difícil… ¡Halloween!"},
    {"inicio": 10.2, "fin": 13.5, "texto": "Toc, toc… ¡un vampiro! Miedo: cuarenta."},
    {"inicio": 14.0, "fin": 17.0, "texto": "¡Ahora una brujita! Setenta."},
    {"inicio": 17.5, "fin": 21.5, "texto": "¿Un dinosaurio? ¡Cien! …¡Plof!"},
    {"inicio": 22.2, "fin": 26.8, "texto": "¡Una calabaza gigante! ¿Quién asustó a quién?"},
    {"inicio": 27.5, "fin": 32.5, "texto": "¡Era una niña disfrazada!"},
    {"inicio": 33.0, "fin": 37.8, "texto": "Y le dice: «Yo también te tenía miedo… ¿Hola?»"},
    {"inicio": 38.2, "fin": 43.6, "texto": "Ella le da un caramelo… ¡y lo comparten!"},
    {"inicio": 44.2, "fin": 49.6, "texto": "Lo que no conocemos asusta. ¡Pero un hola lo cambia todo!"},
    {"inicio": 50.2, "fin": 54.5, "texto": "¿A quién le dirías hola tú? ¡Parte dos, mañana!"}
